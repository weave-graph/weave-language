// Replace each token with one complete JSON string literal before compilation.
// Both exact-CAS graph replacements belong to a single atomic transaction.
transaction offline {
  graph Evidence replace revision {{EVIDENCE_REVISION_JSON}} {
    node "baseline" entity "baseline-quality" space "quality";
    node "gateway-quality" entity "gateway-2" space "quality";
    edge "baseline-ok" from "baseline" to "gateway-quality" relation "quality_ok" polarity positive valid 0 until 100;
    edge "negative-measurement" from "baseline" to "gateway-quality" relation "quality_ok" polarity negative valid 5 until 20 property "note" "offline measurement";
  }
  graph Installation replace revision {{INSTALLATION_REVISION_JSON}} {
    node "device" entity "device-17" space "operations" property "serial" 9007199254740993;
    node "device-physical" entity "device-17" space "physical" property "label" "λ sensor 🚀";
    node "gateway" entity "gateway-2" space "operations";
    edge "connection" from "device" to "gateway" relation "connected" valid 0 until 100;
    attachment "evidence-binding" on edge "connection" key "evidence"
      graph "Evidence" revision "logical:offline:Evidence" valid 0 until 100 required;
  }
}
