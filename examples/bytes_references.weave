function Keep revision "1" (node_ref input) returns node_ref { return param input; }
function Append revision "1" (bytes input, bytes suffix) returns bytes {
  return bytes_concat(param input,param suffix);
}
value Empty bytes "";
value EmptyLength bytes_len(value Empty);
value N node_ref("unavailable", "revision-λ", "same-id");
