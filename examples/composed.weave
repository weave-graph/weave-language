graph Operations {
  node "device" entity "device-17" space "operational";
  node "model-local" entity "model-4" space "catalog";
  edge "uses-model" from "device" to "model-local" relation "model_of" valid 100 until 200;
}
graph Advisories {
  node "model-vendor" entity "model-4" space "catalog";
  node "issue" entity "issue-31" space "advisory";
  edge "affected-model" from "model-vendor" to "issue" relation "affected_by" valid 150 until 250;
}
lens ModelOf from Operations {match relation "model_of";}
lens AffectedBy from Advisories {match relation "affected_by";}
// Join exact stable entity+space identities, not local node ID spellings.
// Result interval is [150,200); both premises remain in provenance.
join Exposure from ModelOf to AffectedBy relation "exposed_to";
// Derivation results are graph values; this parameterized lens consumes one.
lens Window from Exposure {at param instant;}
bind InWindow from Window {time instant 175;}
graph Guidance {
  node "issue-reference" entity "issue-31" space "advisory" property "title" "Example advisory";
  node "fix" entity "fix-2" space "remediation" property "automated" false;
  edge "repair" from "issue-reference" to "fix" relation "fixed_by" valid 170 until 300 property "priority" 2;
  edge "disputed-repair" from "issue-reference" to "fix" relation "fixed_by" polarity negative valid 170 until 300 property "note" "Explicit negative evidence is retained";
}
lens Fixes from Guidance {match relation "fixed_by";}
join Action from InWindow to Fixes relation "needs_fix";
lens Final from Action {at 175;}
